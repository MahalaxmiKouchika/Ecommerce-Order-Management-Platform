# ---------------------------------------------------------------------------
# Supabase & Cloud Database Configuration
# ---------------------------------------------------------------------------
# 1. Supabase PostgreSQL Connection String:
#    From Supabase dashboard -> Project Settings -> Database -> Connection string -> URI:
#    e.g. postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:65432/postgres
DATABASE_URL=

# 2. Supabase API Credentials (Optional - for direct Supabase JS Client usage):
#    From Supabase dashboard -> Project Settings -> API:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Individual parameters (if connecting via direct host parameters):
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=your_supabase_password_here

# ---------------------------------------------------------------------------
# Security & Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_here
ADMIN_SECURITY_KEY=your_admin_security_key_here
